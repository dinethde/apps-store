# Copy to backend/.env. Never commit .env.
# Must line up with the root .env that docker compose reads.
DATABASE_URL=postgresql://appsstore:change-me@localhost:5432/appsstore

PORT=4000

# Where the webapp dev server runs. Only needed until the BFF proxies the API
# (architecture §2.3) — the browser calls this service directly for now.
WEBAPP_ORIGIN=http://localhost:3000
